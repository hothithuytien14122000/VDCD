{
  "name": "survey-api-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright API test suite cho Phan he Khao sat muc do hai long cua nguoi dan (CDS)",
  "scripts": {
    "test": "playwright test",
    "test:readonly": "playwright test --grep-invert @mutation",
    "test:mutation": "cross-env RUN_MUTATION_TESTS=true playwright test --grep @mutation",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5"
  }
}
