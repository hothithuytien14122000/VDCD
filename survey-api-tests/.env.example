# Sao chép file nay thanh ".env" roi dien gia tri that. KHONG commit file .env len git.

# Base URL cua API (khong co dau / cuoi)
BASE_URL=https://cds.geneat.pro

# Access token (JWT) co quyen SUPER_ADMIN, dung cho cac API /api/v1/survey/**
# Dinh dang: chi can phan token, code se tu them "Bearer "
AUTH_TOKEN=

# Dat = true de cho phep chay cac test case co thay doi du lieu that (POST/PUT/DELETE)
# Mac dinh = false (chi chay duoc cac test case GET / doc du lieu)
RUN_MUTATION_TESTS=false

# organizationId hop le de dung cho cac test case tao khao sat (POST/PUT) - API yeu cau
# organizationId phai ton tai va duoc phep su dung, neu khong se tra ve 400.
TEST_ORGANIZATION_ID=
