# ═══════════════════════════════════════════════════════════════════════════
# ui-flow-test-generator — environment config (SAMPLE)
#
# Copy to:  apps/testing/automation-testing/fe-testing/.env  and fill in your values.
# Values passed in chat override .env.
#
# Layout: one shared GLOBAL block + one AUTH block, then a catalogue of per-suite
# blocks. Keep exactly ONE suite block uncommented at a time; leave the rest as
# `#` examples and swap by commenting/uncommenting.
# ═══════════════════════════════════════════════════════════════════════════

# ── Global (set once, shared by every suite) ───────────────────────────────
TESTING_ROOT=apps/testing/automation-testing/fe-testing/   # project root for generated tests
UI_BASE_URL=https://dev-cc-mgios.4mgi.com/       # Playwright baseURL; PAGE_URL resolves against this host
HEADLESS=true                                    # false = headed browser (useful to debug login)
# ⛔ PLAYWRIGHT_EXTENDED_TIMEOUT IS REQUIRED — not a ceiling you may omit.
# It was listed here commented-out, alongside two genuinely optional keys, under a
# header saying "all optional — a missing value keeps the in-code default". That is
# no longer true of this one: lib/timeouts.ts:29 THROWS when it is unset, and the
# throw happens at MODULE LOAD, so the failure is not a red test — Playwright
# collects ZERO tests and reports "No tests found", which reads as a bad --grep or a
# broken spec file. Following this file as written produced exactly that.
# 90000 covers the slowest test ever measured on this suite (76.1s).
PLAYWRIGHT_EXTENDED_TIMEOUT=90000     # REQUIRED — FLOOR for the per-test/per-describe
                                      # overrides (lib/timeouts.ts); never shrinks a
                                      # test below the budget its own waits need.
# The two below ARE optional — a missing/invalid value keeps the in-code default.
# PLAYWRIGHT_TIMEOUT=45000            # per-test default (playwright.config.ts); also
#                                     # the base every per-call tier is derived from
# PLAYWRIGHT_EXPECT_TIMEOUT=15000     # per-assertion default (playwright.config.ts)

# ── Auth (only needed for pages behind login) ──────────────────────────────
UI_AUTH_USERNAME=your.name@example.com
UI_AUTH_PASSWORD=__PUT_YOUR_PASSWORD_HERE__      # ⚠ never commit a real password
# LOGIN_URL=https://dev-cc-mgios.4mgi.com/auth/signin   # override only if not /auth/signin
# Reuse a saved session instead of logging in every run (auto-created by login_and_capture.py):
AUTH_STORAGE_STATE=.auth/user.json

# ═══════════════════════════════════════════════════════════════════════════
# Per-suite config — set these for the feature you are testing RIGHT NOW.
#   SPEC_FILE   = a single spec file, OR
#   SPEC_FILES  = comma-separated list (use trailing \ to wrap lines)
#   PAGE_URL    = root-relative path (host comes from UI_BASE_URL) or a file:// path
#   WORK_ITEM_ID= Azure DevOps User Story id (report is posted here)
#   FEATURE_SCOPE = which feature inside SPEC_FILES to scope test generation to
#   BACKEND_MODE  = real (hit the live API) | mock (MSW fixtures)   [auto-detected if unset]
# ═══════════════════════════════════════════════════════════════════════════

# ── ACTIVE suite ───────────────────────────────────────────────────────────
## Conversation Lifecycle (real backend, multi-spec)
SPEC_FILE=specs/mgi-governance/VIF-GOV-001_Capture_Inbox.md   # the VIF, and nothing else:
                                                # Step 2a resolves CT/ES/EN from its own
                                                # depends_on (resolve_specs.py)
SPEC_ROOTS=specs,.specs-0.3                     # priority order; 0.3 is the fallback tree
PAGE_URL=governance/capture-inbox
WORK_ITEM_ID=149295
FEATURE_SCOPE=Capture Inbox
BACKEND_MODE=real/mock  # auto-detected if unset; set to `real` or `mock` to override