# API Test Generator Configuration
# Copy into apps/testing/automation-testing/be-testing/.env

# Swagger/OpenAPI Specification URL (JSON endpoint) — MANDATORY
SWAGGER_URL=https://dev-api-mgios.4mgi.com/swagger/v1/swagger.json

# API base URL for test execution — MANDATORY (host only, NO /api suffix — endpoint paths
# already start with /api/... in specs and generated tests)
API_BASE_URL=https://dev-api-mgios.4mgi.com

# Test account for password-grant login — MANDATORY
TEST_USERNAME=your_test_account_email
TEST_PASSWORD=your_test_account_password

# Auto-acquired by global-setup.ts from the credentials above — do not set by hand
# API_AUTH_TOKEN=

# Only needed for @retell webhook-signature tests
# RETELL_API_KEY=your_retell_hmac_key

# Project-specific suites may also need per-role credentials (e.g. ENTERPRISE_SOVEREIGN_*,
# BC_SOVEREIGN_*) and fixture ids (SEED_*, TENANT_ID, ...) — add as the driving spec requires them.
